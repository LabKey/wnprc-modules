{
  "name": "cageui",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "npm run build-dev",
    "build-dev": "npm run clean && cross-env NODE_ENV=development rspack build --config node_modules/@labkey/build/configs/dev.config.js",
    "build-ios": "npm run clean && cross-env NODE_ENV=development webpack --config ./ios-webpack/dev.config.js --color",
    "build-prod": "npm run clean && cross-env NODE_ENV=production rspack build --config node_modules/@labkey/build/configs/prod.config.js",
    "clean": "rimraf resources/web/gen && rimraf resources/views/gen",
    "setup": "npm ci --legacy-peer-deps",
    "start": "cross-env NODE_ENV=development rspack serve --config node_modules/@labkey/build/configs/watch.config.js",
    "start-ios": "cross-env NODE_ENV=development LK_MODULE=CageUI webpack-dev-server --config ios-webpack/watch.config.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Board of Regents of the University of Wisconsin System",
  "license": "Apache-2.0",
  "dependencies": {
    "@labkey/api": "1.52.3-fb-update-nodejs.0",
    "@labkey/components": "7.49.1-fb-update-nodejs.0",
    "d3": "^7.9.0",
    "dayjs": "^1.11.21",
    "react": "~18.3.1",
    "react-bootstrap": "~2.10.10",
    "react-dom": "~18.3.1",
    "react-select": "^5.10.2",
    "react-svg": "^16.4.2"
  },
  "devDependencies": {
    "@labkey/build": "10.0.1-fb-update-nodejs.1",
    "@types/d3": "^7.4.3",
    "@types/react": "~18.3.31",
    "@types/react-bootstrap": "~0.32.37",
    "@types/react-dom": "~18.3.7"
  }
}
