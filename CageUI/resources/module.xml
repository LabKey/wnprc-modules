<module xmlns="http://labkey.org/moduleProperties/xml/">
    <clientDependencies>
        <dependency path="webutils/lib/webutils"/>
        <dependency path="webutils/models/models"/>
        <dependency path="ehr/ehr_api"/>
        <dependency path="ehr/ehr_ext3_api"/>
    </clientDependencies>
    <properties>
        <propertyDescriptor name="RecordDeletion">
            <description>Housing history cleanup script that runs every night to delete in progress records</description>
            <inputType>checkbox</inputType>
            <defaultValue>false</defaultValue>
            <editPermissions>
                <permission>ADMIN</permission>
            </editPermissions>
        </propertyDescriptor>
    </properties>
</module>