<tables xmlns="http://labkey.org/data/xml">
    <table tableName="layout_history" tableDbType="TABLE">
        <columns>
            <column columnName="rowid"/>
            <column columnName="room">
                <fk>
                    <fkDbSchema>ehr_lookups</fkDbSchema>
                    <fkTable>rooms</fkTable>
                    <fkColumnName>room</fkColumnName>
                </fk>
            </column>
            <column columnName="extra_context"/>
            <column columnName="object_type">
                <datatype>integer</datatype>
                <fk>
                    <fkDbSchema>ehr_lookups</fkDbSchema>
                    <fkTable>cageui_item_types</fkTable>
                    <fkColumnName>value</fkColumnName>
                    <fkDisplayColumnName>title</fkDisplayColumnName>
                </fk>
            </column>
            <column columnName="rack_group"/>
            <column columnName="rack"/>
            <column columnName="cage">
                <url>/EHR/cageDetails.view?room=${room}&amp;cage=${cage}&amp;</url>
            </column>
            <column columnName="start_date"/>
            <column columnName="end_date"/>
            <column columnName="x_coord"/>
            <column columnName="y_coord"/>
            <column columnName="container"/>
            <column columnName="createdby"/>
            <column columnName="created"/>
            <column columnName="modified"/>
            <column columnName="modifiedby"/>
        </columns>
    </table>
    <table tableName="racks" tableDbType="TABLE">
        <columns>
            <column columnName="rowid"/>
            <column columnName="rackid"/>
            <column columnName="rack_type">
                <fk>
                    <fkDbSchema>cageui</fkDbSchema>
                    <fkTable>rack_types</fkTable>
                    <fkColumnName>name</fkColumnName>
                </fk>
            </column>
            <column columnName="container"/>
            <column columnName="createdby"/>
            <column columnName="created"/>
            <column columnName="modified"/>
            <column columnName="modifiedby"/>
        </columns>
    </table>
    <table tableName="rack_types" tableDbType="TABLE">
        <columns>
            <column columnName="rowid"/>
            <column columnName="name"/>
            <column columnName="type">
                <fk>
                    <fkDbSchema>ehr_lookups</fkDbSchema>
                    <fkTable>cageui_item_types</fkTable>
                    <fkColumnName>value</fkColumnName>
                    <fkDisplayColumnName>title</fkDisplayColumnName>
                    <filters>
                        <filterGroup>
                            <filter column="category" value="Caging" operator="eq"/>
                        </filterGroup>
                    </filters>
                </fk>
            </column>
            <column columnName="manufacturer">
                <fk>
                    <fkDbSchema>ehr_lookups</fkDbSchema>
                    <fkTable>cageui_rack_manufacturers</fkTable>
                    <fkColumnName>value</fkColumnName>
                    <fkDisplayColumnName>title</fkDisplayColumnName>
                    <filters>
                        <filterGroup>
                            <filter column="category" value="Caging" operator="eq"/>
                        </filterGroup>
                    </filters>
                </fk>
            </column>
            <column columnName="length"/>
            <column columnName="width"/>
            <column columnName="height"/>
            <column columnName="sqft"/>
            <column columnName="supportsTunnel"/>
            <column columnName="description"/>
            <column columnName="container"/>
            <column columnName="createdby"/>
            <column columnName="created"/>
            <column columnName="modified"/>
            <column columnName="modifiedby"/>
        </columns>
    </table>
    <table tableName="cage_modifications" tableDbType="TABLE">
        <columns>
            <column columnName="rowid"/>
            <column columnName="room"/>
            <column columnName="rack"/>
            <column columnName="cage"/>
            <column columnName="modification">
                <fk>
                    <fkDbSchema>ehr_lookups</fkDbSchema>
                    <fkTable>cageui_cage_modifications</fkTable>
                    <fkColumnName>value</fkColumnName>
                    <fkDisplayColumnName>title</fkDisplayColumnName>
                    <filters>
                        <filterGroup>
                            <filter column="category" value="Caging" operator="eq"/>
                        </filterGroup>
                    </filters>
                </fk>
            </column>
            <column columnName="startDate"/>
            <column columnName="endDate"/>
            <column columnName="createdby"/>
            <column columnName="created"/>
            <column columnName="modified"/>
            <column columnName="modifiedby"/>
        </columns>
    </table>
</tables>