<?xml version="1.0" encoding="UTF-8"?>
<templates xmlns="http://labkey.org/data/xml/domainTemplate"
           xmlns:dat="http://labkey.org/data/xml"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <template xsi:type="EHRLookupsTemplateType">
        <table tableName="cage_type" tableDbType="TABLE">
            <dat:tableTitle>Cage Type</dat:tableTitle>
            <dat:columns>
                <dat:column columnName="type">
                    <dat:rangeURI>string</dat:rangeURI>
                    <dat:fk>
                        <dat:fkDbSchema>ehr_lookups</dat:fkDbSchema>
                        <dat:fkTable>cageui_item_types</dat:fkTable>
                        <dat:fkColumnName>value</dat:fkColumnName>
                        <dat:fkDisplayColumnName>title</dat:fkDisplayColumnName>
                    </dat:fk>
                </dat:column>
                <dat:column columnName="manufacturer">
                    <dat:rangeURI>string</dat:rangeURI>
                    <dat:fk>
                        <dat:fkDbSchema>ehr_lookups</dat:fkDbSchema>
                        <dat:fkTable>cageui_rack_manufacturers</dat:fkTable>
                        <dat:fkColumnName>value</dat:fkColumnName>
                        <dat:fkDisplayColumnName>title</dat:fkDisplayColumnName>
                    </dat:fk>
                </dat:column>
                <dat:column columnName="isDefault">
                    <dat:rangeURI>boolean</dat:rangeURI>
                </dat:column>
            </dat:columns>
        </table>
    </template>
    <template xsi:type="EHRLookupsTemplateType">
        <table tableName="rooms" tableDbType="TABLE">
            <dat:tableTitle>Rooms</dat:tableTitle>
            <dat:columns>
                <dat:column columnName="layout_scale">
                    <dat:rangeURI>double</dat:rangeURI>
                </dat:column>
                <dat:column columnName="border_width">
                    <dat:rangeURI>int</dat:rangeURI>
                </dat:column>
                <dat:column columnName="border_height">
                    <dat:rangeURI>int</dat:rangeURI>
                </dat:column>
            </dat:columns>
        </table>
    </template>

</templates>