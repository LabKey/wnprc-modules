<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="rooms" tableDbType="TABLE">
                <tableUrl>/wnprc_ehr/cageDetails.view?room=${room}</tableUrl>
                <columns>
                    <column columnName="room">
                        <isKeyField>true</isKeyField>
                    </column>
                    <column columnName="species">
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>species</fkTable>
                            <fkColumnName>common</fkColumnName>
                        </fk>
                    </column>
                </columns>
                <titleColumn>room</titleColumn>
                <pkColumnName>room</pkColumnName>
            </table>
        </tables>
    </metadata>
</query>
